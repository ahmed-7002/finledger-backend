# ==== Server ====
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ==== Neon Serverless PostgreSQL ====
# Get this from your Neon project dashboard (Connection Details -> Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/khaatabook?sslmode=require

# ==== Clerk (Authentication) ====
# https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=your clerk secret key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# ==== Cloudinary (Receipt / Invoice image uploads) ====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ==== Payment Gateway Webhook (Safepay) ====
# Secret used to verify the HMAC signature on incoming Safepay webhook
# events. Get this from your Safepay dashboard once onboarded — confirm
# the exact signing header name there too (see backend/src/routes/webhooks.js).
PAYMENT_WEBHOOK_SECRET=your webhook secret key
